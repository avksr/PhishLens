        "synthesis_breakdown": {
          "weights_applied": {
            "url_weight": 0.40,
            "sender_weight": 0.30,
            "intent_weight": 0.30
          },
          "heuristics_triggered": [
            "CRITICAL_ESCALATION: High risk URL combined with Personal GSM sender claiming Tier-1 Indian Bank",
            "Active credential harvesting pattern detected across all 3 independent vectors"
          ],
          "summary_explanation": "All three autonomous agents independently flagged severe anomalies: Domain age (2 days), unauthorized personal sender ID, and coercive fear-based KYC extortion."
        }
      },
      "processing_time_ms": 820.5
    },
    "sample_safe_request": {
