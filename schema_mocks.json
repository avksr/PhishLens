      "extracted_url": "https://sbi-kyc-verify.top",
      "channel": "sms",
      "metadata": {
        "client_timestamp": "2026-09-29T12:45:00Z",
        "device_platform": "android"
      }
    },
    "sample_high_risk_response": {
