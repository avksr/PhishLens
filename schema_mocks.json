{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PhishLensDataContract",
  "description": "Unified schema and mock payloads for PhishLens real-time scam interception pipeline",
  "definitions": {
    "ScanRequest": {
      "type": "object",
      "required": ["content"],
      "properties": {
        "content": {
          "type": "string",
          "description": "The raw message text, email body, or payment note to inspect",
          "minLength": 1,
          "maxLength": 8000,
          "example": "URGENT: Your SBI account #XXXX1234 is suspended due to missing PAN. Update immediately at https://sbi-kyc-update.top to prevent freeze."
        },
        "sender": {
          "type": "string",
          "description": "Sender identifier if available (e.g. phone number, SMS header like 'VM-SBIINB', or email address)",
          "example": "+91-9876543210"
        },
        "extracted_url": {
          "type": "string",
          "description": "Pre-extracted URL if user specifically entered a link or frontend extracted it",
          "example": "https://sbi-kyc-update.top"
        },
        "channel": {
          "type": "string",
          "enum": ["sms", "whatsapp", "email", "qr_payment", "web_url", "unknown"],
          "default": "sms"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "client_timestamp": { "type": "string", "format": "date-time" },
            "device_platform": { "type": "string", "example": "android" }
          }
        }
      }
    },
    "UrlAgentResult": {
      "type": "object",
      "required": ["risk_score", "flags", "details"],
      "properties": {
        "status": { "type": "string", "enum": ["SUCCESS", "SKIPPED", "ERROR"] },
        "url_analyzed": { "type": "string", "nullable": true },
        "risk_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "domain_age_days": { "type": "integer", "nullable": true },
        "is_typosquatting": { "type": "boolean" },
        "target_brand": { "type": "string", "nullable": true },
        "tld_reputation": { "type": "string", "enum": ["HIGH_RISK", "NEUTRAL", "REPUTABLE"] },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "details": { "type": "string" },
        "latency_ms": { "type": "number" }
      }
    },
    "SenderAgentResult": {
      "type": "object",
      "required": ["risk_score", "flags", "details"],
      "properties": {
        "status": { "type": "string", "enum": ["SUCCESS", "SKIPPED", "ERROR"] },
        "sender_analyzed": { "type": "string", "nullable": true },
        "risk_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "is_spoofed_header": { "type": "boolean" },
        "sender_category": { "type": "string", "enum": ["OFFICIAL_TRAI_HEADER", "PERSONAL_GSM", "INTERNATIONAL", "LOOKALIKE_HEADER", "UNKNOWN"] },
        "brand_claimed": { "type": "string", "nullable": true },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "details": { "type": "string" },
        "latency_ms": { "type": "number" }
      }
    },
    "IntentAgentResult": {
      "type": "object",
      "required": ["risk_score", "flags", "details"],
      "properties": {
        "status": { "type": "string", "enum": ["SUCCESS", "SKIPPED", "ERROR"] },
        "risk_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "detected_intent": { "type": "string", "enum": ["PANIC_URGENCY", "FINANCIAL_EXTORTION", "LOTTERY_REWARD", "KYC_VERIFICATION", "OTP_HARVEST", "BENIGN", "SUSPICIOUS"] },
        "manipulation_tactics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reasoning": { "type": "string" },
        "details": { "type": "string" },
        "latency_ms": { "type": "number" }
      }
    },
    "AuditTrail": {
      "type": "object",
      "required": ["url_analysis", "sender_analysis", "intent_analysis", "synthesis_breakdown"],
      "properties": {
        "url_analysis": { "$ref": "#/definitions/UrlAgentResult" },
        "sender_analysis": { "$ref": "#/definitions/SenderAgentResult" },
        "intent_analysis": { "$ref": "#/definitions/IntentAgentResult" },
        "synthesis_breakdown": {
          "type": "object",
          "properties": {
            "weights_applied": {
              "type": "object",
              "properties": {
                "url_weight": { "type": "number" },
                "sender_weight": { "type": "number" },
                "intent_weight": { "type": "number" }
              }
            },
            "heuristics_triggered": {
              "type": "array",
              "items": { "type": "string" }
            },
            "summary_explanation": { "type": "string" }
          }
        }
      }
    },
    "ScanResponse": {
      "type": "object",
      "required": ["scan_id", "overall_risk_score", "risk_tier", "verdict", "recommendation", "audit_trail", "processing_time_ms"],
      "properties": {
        "scan_id": { "type": "string", "format": "uuid" },
        "timestamp": { "type": "string", "format": "date-time" },
        "overall_risk_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Normalized scam probability score (0-100)"
        },
        "risk_tier": {
          "type": "string",
          "enum": ["SAFE", "CAUTION", "HIGH_RISK", "CRITICAL"],
          "description": "Tier determining frontend modal behavior (Informational vs Active Interception Blocking)"
        },
        "verdict": {
          "type": "string",
          "example": "High Probability Banking Impersonation Phishing"
        },
        "recommendation": {
          "type": "string",
          "example": "DO NOT click the link or provide credentials. SBI never uses '.top' domains."
        },
        "action_required": {
          "type": "string",
          "enum": ["ALLOW", "WARN_USER", "BLOCK_TRANSACTION"],
          "example": "BLOCK_TRANSACTION"
        },
        "audit_trail": { "$ref": "#/definitions/AuditTrail" },
        "processing_time_ms": {
          "type": "number",
          "description": "Total end-to-end processing latency in ms (<5000ms SLA target)"
        }
      }
    }
  },
  "mock_examples": {
    "sample_high_risk_request": {
      "content": "URGENT: SBI customer! Your account 4321 is blocked today. To unblock immediately submit your Aadhaar & Pan details at https://sbi-kyc-verify.top or call 9876543210. Failing which account deactivated within 2 hours.",
