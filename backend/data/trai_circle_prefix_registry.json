  "known_invalid_or_unregistered_prefixes": {
    "BZ": {
      "note": "BZ is NOT a registered TRAI DLT operator prefix. Any header starting with BZ- is unregistered / suspicious.",
      "active": false
    },
    "XX": {
      "note": "XX is NOT a registered TRAI DLT operator prefix.",
      "active": false
    },
    "ZZ": {
      "note": "ZZ is NOT a registered TRAI DLT operator prefix.",
      "active": false
    }
  },
  "header_validation_rules": {
    "format": "^([A-Z]{2})-([A-Z]{6})$",
    "operator_prefix_length": 2,
    "entity_code_length": 6,
    "separator": "-",
    "case_requirement": "UPPERCASE_ONLY",
    "notes": [
      "Headers submitted in lowercase or mixed-case are NEVER legitimate — TRAI mandates ALL-CAPS for DLT headers.",
      "The 2-letter operator prefix MUST match a registered operator in valid_prefixes.",
      "The 6-letter entity code MUST be registered on the TRAI DLT platform under the given operator.",
      "Any prefix not in valid_prefixes is unregistered and likely fraudulent.",
      "Unicode homoglyphs in headers (e.g. Cyrillic characters mimicking Latin) are a strong spoof indicator."
    ]
  }
