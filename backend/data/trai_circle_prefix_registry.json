  "_meta": {
    "description": "TRAI Commercial SMS Operator-Prefix Registry for PhishLens / ScamShield AI",
    "format": "operator_prefix (2-letter) -> { operator_name, circles, category, active }",
    "last_updated": "2026-09-30",
    "source": "TRAI DLT Platform Operator Registrations (https://www.trai.gov.in/), TRAI SMS Header Guidelines",
    "note": "Each 2-letter prefix is assigned to a specific licensed telecom operator by TRAI. A commercial SMS header MUST begin with one of these registered prefixes followed by a hyphen and a 6-letter Principal Entity code (e.g. VM-SBIINB). Any prefix NOT in this registry is either invalid or fraudulent."
  },
