# ============================================================
# PhishLens (ScamShield AI) — Environment Configuration Template
# ============================================================

# ── Primary LLM Provider (Groq Cloud) ────────────────────────
# Get your free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Fallback LLM Provider (Google Gemini) ─────────────────────
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Offline & Demo Fallback Behavior ─────────────────────────
# If neither GROQ_API_KEY nor GEMINI_API_KEY is provided, PhishLens
# automatically switches to its high-speed (<50ms) local regex
# heuristic engine. The demo will NEVER crash or fail if keys are missing.

# ── Security & Rate Limiting (GIGW 3.0 / CERT-In) ────────────
RATE_LIMIT_PER_MINUTE=30
MAX_CONTENT_LENGTH=8000

# ── Threat Intelligence Providers (Optional / Tiered) ─────────
# PhishLens uses a 4-tier threat intelligence architecture:
# Tier 1: Local OpenPhish / URLhaus feeds (always available)
# Tier 2: Google Safe Browsing API v4
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here
# Tier 3: AlienVault OTX Pulse Lookup
OTX_API_KEY=your_alienvault_otx_api_key_here
# Tier 4: VirusTotal API v3 (Rate limited: 4 req/min, 500/day, demo only)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# ── Server Configuration ─────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=False
