# ============================================================
# PhishLens (ScamShield AI) — Production Environment Configuration
# ============================================================

# ── Primary LLM Provider (Groq Cloud) ────────────────────────
# Free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Fallback LLM & Vision Provider (Google Gemini) ───────────
# Free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── OSINT & Web Intelligence Providers ───────────────────────
# Brave Search API key at: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# Reddit API credentials at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=PhishLens:v1.0 (by /u/scamshield_bot)

# DuckDuckGo HTML scraping fallback (OFF by default for security & zero-blocking)
ENABLE_DDG_SCRAPING=false

# ── Threat Intelligence Providers (Optional / Tiered) ─────────
# Google Safe Browsing API v4
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# AlienVault OTX Pulse Lookup
OTX_API_KEY=your_alienvault_otx_api_key_here

# VirusTotal API v3 (Rate limited: 4 req/min, 500/day)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# ── Database & Persistence (Supabase Postgres & Local SQLite) ─
# Supabase Postgres connection string (fallback to local SQLite if unset)
DATABASE_URL=postgresql://postgres:your_password@db.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# ── Rate Limiting & GIGW 3.0 Compliance ───────────────────────
RATE_LIMIT_PER_MINUTE=30
MAX_CONTENT_LENGTH=8000
MAX_UPLOAD_SIZE_MB=5
PRODUCTION_MODE=false

# ── Provider Budget Quota Limits (Requests / Minute) ─────────
PROVIDER_GROQ_LIMIT=30
PROVIDER_GEMINI_LIMIT=15
PROVIDER_BRAVE_SEARCH_LIMIT=20
PROVIDER_REDDIT_LIMIT=30
PROVIDER_VIRUSTOTAL_LIMIT=4
PROVIDER_GOOGLE_SAFE_BROWSING_LIMIT=60

# ── Server Configuration ─────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=False
